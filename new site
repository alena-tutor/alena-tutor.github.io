      const desc=document.createElement("div");
      desc.className="tiny";
      desc.textContent=plan.description || "Описание не задано";

      const btnRow=document.createElement("div");
      btnRow.style.display="flex";
      btnRow.style.gap="4px";
      btnRow.style.justifyContent="flex-end";
      btnRow.style.marginTop="4px";

      const btnOpen=document.createElement("button");
      btnOpen.className="btn-chip small";
      btnOpen.textContent="Открыть";
      btnOpen.onclick=(e)=>{e.stopPropagation();openPlanDetail(plan.id);};

      const btnDel=document.createElement("button");
      btnDel.className="btn-chip small danger";
      btnDel.textContent="Удалить";
      btnDel.onclick=(e)=>{
        e.stopPropagation();
        if(!confirm("Удалить этот учебник и его КТП? Уроки учеников не трогаем.")) return;
        data.coursePlans = data.coursePlans.filter(p=>p.id!==plan.id);
        save();
      };

      btnRow.appendChild(btnOpen);
      btnRow.appendChild(btnDel);

      item.appendChild(top);
      item.appendChild(desc);
      item.appendChild(btnRow);
      list.appendChild(item);
    });

    card.appendChild(list);
    main.appendChild(card);
  }

  function renderPlanDetail(main,planId){
    const plan = (data.coursePlans||[]).find(p=>p.id===planId);
    if(!plan){
      const card=document.createElement("section");
      card.className="card";
      card.textContent="Учебник не найден.";
      main.appendChild(card);
      return;
    }

    const card=document.createElement("section");
    card.className="card";

    const header=document.createElement("div");
    header.className="card-header";
    const left=document.createElement("div");
    const title=document.createElement("div");
    title.className="card-title";
    title.textContent=`КТП: ${plan.title || "Учебник"}`;
    const subtitle=document.createElement("div");
    subtitle.className="card-subtitle";
    subtitle.textContent="Здесь ты прописываешь общий план по учебнику.";
    left.appendChild(title);
    left.appendChild(subtitle);

    const btnBack=document.createElement("button");
    btnBack.className="btn-secondary";
    btnBack.textContent="← Ко всем учебникам";
    btnBack.onclick=()=>{currentView="plans";render();};

    header.appendChild(left);
    header.appendChild(btnBack);
    card.appendChild(header);

    /* Общее про учебник */
    const info=document.createElement("div");
    info.className="form-section";

    const row1=document.createElement("div");
    row1.className="form-row-inline";

    const colTitle=document.createElement("div");
    const lblTitle=document.createElement("div");
    lblTitle.className="form-label";
    lblTitle.textContent="Название учебника / курса";
    const inTitle=document.createElement("input");
    inTitle.className="form-input";
    inTitle.value=plan.title || "";
    colTitle.appendChild(lblTitle);
    colTitle.appendChild(inTitle);

    const colDesc=document.createElement("div");
    const lblDesc=document.createElement("div");
    lblDesc.className="form-label";
    lblDesc.textContent="Краткое описание";
    const inDesc=document.createElement("input");
    inDesc.className="form-input";
    inDesc.value=plan.description || "";
    colDesc.appendChild(lblDesc);
    colDesc.appendChild(inDesc);

    row1.appendChild(colTitle);
    row1.appendChild(colDesc);

    const actionsInfo=document.createElement("div");
    actionsInfo.className="form-actions";
    const btnSaveInfo=document.createElement("button");
    btnSaveInfo.className="btn-main";
    btnSaveInfo.textContent="Сохранить учебник";
    btnSaveInfo.onclick=()=>{
      plan.title = inTitle.value.trim() || plan.title;
      plan.description = inDesc.value.trim();
      save();
    };
    actionsInfo.appendChild(btnSaveInfo);

    info.appendChild(row1);
    info.appendChild(actionsInfo);
    card.appendChild(info);

    /* Добавление урока в КТП */
    const addBlock=document.createElement("div");
    addBlock.className="form-section";
    const addTitle=document.createElement("div");
    addTitle.className="card-title";
    addTitle.style.fontSize="13px";
    addTitle.textContent="Добавить урок в КТП";
    addBlock.appendChild(addTitle);

    const rowL=document.createElement("div");
    rowL.className="form-row-inline";

    const colName=document.createElement("div");
    const lblLName=document.createElement("div");
    lblLName.className="form-label";
    lblLName.textContent="Название урока";
    const inLName=document.createElement("input");
    inLName.className="form-input";
    inLName.placeholder="например, Unit 3 Lesson 1";
    colName.appendChild(lblLName);
    colName.appendChild(inLName);

    const colTopic=document.createElement("div");
    const lblLTopic=document.createElement("div");
    lblLTopic.className="form-label";
    lblLTopic.textContent="Тема (подробнее)";
    const inLTopic=document.createElement("input");
    inLTopic.className="form-input";
    inLTopic.placeholder="Past Simple, чтение текста про ...";
    colTopic.appendChild(lblLTopic);
    colTopic.appendChild(inLTopic);

    rowL.appendChild(colName);
    rowL.appendChild(colTopic);

    const rowHW=document.createElement("div");
    rowHW.className="form-row";
    const lblLHW=document.createElement("div");
    lblLHW.className="form-label";
    lblLHW.textContent="Рекомендованное домашнее задание";
    const inLHW=document.createElement("textarea");
    inLHW.placeholder="SB p.34 ex.3, WB p.18 ex.1-2";
    rowHW.appendChild(lblLHW);
    rowHW.appendChild(inLHW);

    const actionsAdd=document.createElement("div");
    actionsAdd.className="form-actions";
    const btnAddLesson=document.createElement("button");
    btnAddLesson.className="btn-secondary";
    btnAddLesson.textContent="Добавить урок в конец КТП";
    btnAddLesson.onclick=()=>{
      const tName=inLName.value.trim();
      const tTopic=inLTopic.value.trim();
      const tHW=inLHW.value.trim();
      if(!tName && !tTopic){
        alert("Нужно хотя бы название урока или тему.");
        return;
      }
      const newId = (plan.lessons && plan.lessons.length)
        ? Math.max(...plan.lessons.map(x=>x.id))+1
        : 1;
      if(!plan.lessons) plan.lessons=[];
      plan.lessons.push({
        id:newId,
        title:tName,
        topic:tTopic,
        homework:tHW
      });
      save();
      inLName.value="";
      inLTopic.value="";
      inLHW.value="";
    };

    actionsAdd.appendChild(btnAddLesson);

    addBlock.appendChild(rowL);
    addBlock.appendChild(rowHW);
    addBlock.appendChild(actionsAdd);
    card.appendChild(addBlock);

    /* Список уроков КТП */
    const listBlock=document.createElement("div");
    listBlock.className="form-section";
    const listTitle=document.createElement("div");
    listTitle.className="card-title";
    listTitle.style.fontSize="13px";
    listTitle.textContent="Уроки в КТП (по порядку)";
    listBlock.appendChild(listTitle);

    if(!plan.lessons || !plan.lessons.length){
      const empty=document.createElement("div");
      empty.className="tiny";
      empty.textContent="Пока уроков нет. Добавляй выше.";
      listBlock.appendChild(empty);
    } else {
      const list=document.createElement("div");
      list.className="lesson-list";
      plan.lessons.forEach((les,index)=>{
        const item=document.createElement("div");
        item.className="lesson-card";
        item.style.cursor="default";

        const top=document.createElement("div");
        top.className="lesson-top";
        const left=document.createElement("div");
        left.textContent=`${index+1}. ${les.title || les.topic || "Урок"}`;
        const right=document.createElement("div");
        right.className="tiny";
        right.textContent=`ID: ${les.id}`;
        top.appendChild(left);
        top.appendChild(right);

        const meta=document.createElement("div");
        meta.className="tiny";
        meta.innerHTML =
          `<strong>Тема:</strong> ${les.topic || "—"}<br>`+
          `<strong>Домашка:</strong> ${les.homework || "—"}`;

        const btnRow=document.createElement("div");
        btnRow.style.display="flex";
        btnRow.style.gap="4px";
        btnRow.style.marginTop="4px";
        btnRow.style.justifyContent="flex-end";

        const btnEdit=document.createElement("button");
        btnEdit.className="btn-chip small";
        btnEdit.textContent="Изменить";
        btnEdit.onclick=(e)=>{
          e.stopPropagation();
          const newTitle=prompt("Название урока",les.title||"") ?? les.title;
          const newTopic=prompt("Тема (подробнее)",les.topic||"") ?? les.topic;
          const newHW=prompt("Домашка",les.homework||"") ?? les.homework;
          les.title=newTitle.trim();
          les.topic=newTopic.trim();
          les.homework=newHW.trim();
          save();
        };

        const btnDel=document.createElement("button");
        btnDel.className="btn-chip small danger";
        btnDel.textContent="Удалить";
        btnDel.onclick=(e)=>{
          e.stopPropagation();
          if(!confirm("Удалить этот урок из КТП?")) return;
          plan.lessons = plan.lessons.filter(x=>x.id!==les.id);
          save();
        };

        btnRow.appendChild(btnEdit);
        btnRow.appendChild(btnDel);

        item.appendChild(top);
        item.appendChild(meta);
        item.appendChild(btnRow);

        list.appendChild(item);
      });
      listBlock.appendChild(list);
    }

    card.appendChild(listBlock);
    main.appendChild(card);
  }

  /* НАСТРОЙКИ + ВЫХОД */

    function renderSettings(main){
    const card=document.createElement("section");
    card.className="card";

    const header=document.createElement("div");
    header.className="card-header";
    const left=document.createElement("div");
    const title=document.createElement("div");
    title.className="card-title";
    title.textContent="Настройки";
    const subtitle=document.createElement("div");
    subtitle.className="card-subtitle";
    subtitle.textContent="Часовой пояс и управление данными.";
    left.appendChild(title);
    left.appendChild(subtitle);
    header.appendChild(left);
    card.appendChild(header);

    /* Блок: часовой пояс */
    const block=document.createElement("div");
    block.className="form-section";

    const tzRow=document.createElement("div");
    tzRow.className="form-row";
    const lbl=document.createElement("div");
    lbl.className="form-label";
    lbl.textContent="Часовой пояс преподавателя";
    const sel=document.createElement("select");
    sel.className="form-select";
    ALL_TZ.forEach(tz=>{
      const opt=document.createElement("option");
      opt.value=tz;opt.textContent=tz;
      if(tz===data.tutorTZ) opt.selected=true;
      sel.appendChild(opt);
    });
    sel.onchange=()=>{
      data.tutorTZ=sel.value;
      save();
    };
    tzRow.appendChild(lbl);
    tzRow.appendChild(sel);

    block.appendChild(tzRow);
    card.appendChild(block);

    /* Блок: резервное копирование */
    const backup=document.createElement("div");
    backup.className="form-section";

    const bTitle=document.createElement("div");
    bTitle.className="card-title";
    bTitle.style.fontSize="13px";
    bTitle.textContent="Резервное копирование (экспорт / импорт)";
    const bText=document.createElement("div");
    bText.className="tiny";
    bText.innerHTML =
      "Экспорт создаёт текст с данными (ученики, уроки, абонементы, КТП). " +
      "Сохрани этот текст в файл/заметки. При импорте вставь его обратно и нажми «Импортировать».";

    const bRow=document.createElement("div");
    bRow.className="form-row";
    const bLbl=document.createElement("div");
    bLbl.className="form-label";
    bLbl.textContent="Текст резервной копии (JSON)";
    const backupArea=document.createElement("textarea");
    backupArea.placeholder = "Нажми «Экспортировать данные» — здесь появится текст.\n" +
                              "Скопируй его и сохрани. Чтобы восстановить — вставь сюда сохранённый текст и нажми «Импортировать данные».";
    bRow.appendChild(bLbl);
    bRow.appendChild(backupArea);

    const bActions=document.createElement("div");
    bActions.className="form-actions";
    const btnExport=document.createElement("button");
    btnExport.className="btn-secondary";
    btnExport.textContent="Экспортировать данные в текст ниже";
    btnExport.onclick=()=>{
      try{
        const json = JSON.stringify(data,null,2);
        backupArea.value = json;
        backupArea.focus();
        backupArea.select();
        alert("Данные выгружены. Скопируй текст и сохрани его в безопасном месте.");
      }catch(e){
        console.error(e);
        alert("Не удалось экспортировать данные.");
      }
    };

    const btnImport=document.createElement("button");
    btnImport.className="btn-main";
    btnImport.textContent="Импортировать данные из текста";
    btnImport.onclick=()=>{
      const text = backupArea.value.trim();
      if(!text){
        alert("Вставь сюда текст резервной копии.");
        return;
      }
      if(!confirm("Текущие данные будут заменены данными из текста. Продолжить?")){
        return;
      }
      try{
        const parsed = JSON.parse(text);
        if(!parsed || typeof parsed!=="object" || !Array.isArray(parsed.students)){
          alert("Похоже, это не резервная копия этого кабинета (нет поля students).");
          return;
        }
        // Сохраняем сырые данные и заново инициализируем через loadData(),
        // чтобы добавить недостающие поля/структуру.
        localStorage.setItem(STORAGE_KEY, text);
        data = loadData();
        render();
        alert("Данные успешно импортированы.");
      }catch(e){
        console.error(e);
        alert("Ошибка при разборе JSON. Проверь, что текст не повреждён.");
      }
    };

    bActions.appendChild(btnExport);
    bActions.appendChild(btnImport);

    backup.appendChild(bTitle);
    backup.appendChild(bText);
    backup.appendChild(bRow);
    backup.appendChild(bActions);

    card.appendChild(backup);

    /* Блок: полный сброс */
    const danger=document.createElement("div");
    danger.className="form-section";
    danger.style.background="var(--danger-soft)";
    danger.style.borderColor="#F0BDB8";

    const dTitle=document.createElement("div");
    dTitle.className="card-title";
    dTitle.style.fontSize="13px";
    dTitle.textContent="Сбросить кабинет";
    const dText=document.createElement("div");
    dText.className="tiny";
    dText.textContent="Удалит всех учеников, уроки и абонементы из этого браузера. Назад вернуть нельзя (если нет резервной копии).";
    const btnReset=document.createElement("button");
    btnReset.className="btn-danger";
    btnReset.textContent="Удалить все данные";
    btnReset.onclick=()=>{
      if(confirm("Точно удалить ВСЕ данные (учеников, уроки, абонементы, КТП)?")) {
        localStorage.removeItem(STORAGE_KEY);
        data = loadData();
        render();
      }
    };

    danger.appendChild(dTitle);
    danger.appendChild(dText);
    danger.appendChild(btnReset);

    card.appendChild(danger);

    main.appendChild(card);
  }

  function renderLogout(main){
    const card=document.createElement("section");
    card.className="card";

    const header=document.createElement("div");
    header.className="card-header";
    const title=document.createElement("div");
    title.className="card-title";
    title.textContent="Выход";
    const subtitle=document.createElement("div");
    subtitle.className="card-subtitle";
    subtitle.textContent="В офлайн-версии логина нет — это только твой кабинет.";
    header.appendChild(title);
    header.appendChild(subtitle);
    card.appendChild(header);

    const text=document.createElement("div");
    text.className="tiny";
    text.innerHTML =
      "Сейчас кабинет работает как личное приложение в этом браузере. "+
      "Чтобы никто больше не видел данные, просто не давай доступ к компьютеру/браузеру. "+
      "Когда появится онлайн-авторизация, здесь будет настоящая кнопка выхода.";

    card.appendChild(text);
    main.appendChild(card);
  }

  /* ROOT RENDER */

  const mainCol=document.getElementById("mainCol");
  const navBtns=document.querySelectorAll(".nav-btn");

  navBtns.forEach(btn=>{
    btn.onclick=()=>{
      navBtns.forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      currentView=btn.dataset.view;
      render();
    };
  });

  function render(){
    renderHeaderInfo();
    mainCol.innerHTML="";
    if(currentView==="today") renderToday(mainCol);
    else if(currentView==="calendar") renderCalendar(mainCol);
    else if(currentView==="students") renderStudents(mainCol);
    else if(currentView==="parents") renderParents(mainCol);
    else if(currentView==="student") renderStudent(mainCol,currentStudentId);
    else if(currentView==="editStudent") renderEditStudent(mainCol,currentStudentId);
    else if(currentView==="lesson") renderLesson(mainCol,currentLessonId);
    else if(currentView==="subscriptions") renderSubscriptions(mainCol);
    else if(currentView==="subscriptionEdit") renderSubscriptionEdit(mainCol,currentSubscriptionStudentId);
    else if(currentView==="journal") renderJournal(mainCol);
    else if(currentView==="plans") renderPlans(mainCol);
    else if(currentView==="planDetail") renderPlanDetail(mainCol,currentPlanId);
    else if(currentView==="settings") renderSettings(mainCol);
    else if(currentView==="logout") renderLogout(mainCol);
  }

  render();
</script>
