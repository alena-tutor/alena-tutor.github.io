  /* MESSENGERS: напоминания и домашка */

  function sendLessonReminder(lesson,student){
    if(!student){alert("Ученик не найден");return;}
    const text=`Напоминание 🌿\nСегодня занятие в ${lesson.time}.\nТема: ${lesson.topic||"(уточним на уроке)"}`;
    openMessenger(student,text);
  }

  function sendHomework(lesson,student){
    if(!student){alert("Ученик не найден");return;}
    const text=`Домашнее задание 📚\n${lesson.hw||"Скоро пришлю задание."}`;
    openMessenger(student,text);
  }

  function notifySubscription(student, stats){
    const {remaining,total,price,paid,doneCount} = stats;
    let text;
    if(total>0 && remaining<=0){
      text =
        `Добрый день! У ${student.name} закончился абонемент `+
        `(${total} занятий, проведено ${doneCount}). `+
        `Пожалуйста, обновите оплату. Стоимость: ${price} ₽, оплачено: ${paid} ₽.`;
    } else if(total>0 && remaining<=2){
      text =
        `Добрый день! У ${student.name} скоро заканчивается абонемент. `+
        `Осталось ${remaining} занятий из ${total}.`;
    } else {
      text =
        `Информация по абонементу ${student.name}: проведено ${doneCount} из ${total} занятий.`;
    }
    openParentMessenger(student,text);
  }

  function openMessenger(student,text){
    if(!student.contact){
      alert("У ученика не указан контакт.");
      return;
    }
    openMessengerBy(student.contactType || "phone", student.contact, text);
  }

  function openParentMessenger(student,text){
    let type = student.parentContactType || "phone";
    let contact = (student.parentContact || "").trim();
    if(!contact){
      type = student.contactType || "phone";
      contact = (student.contact || "").trim();
    }
    if(!contact){
      alert("Не указан контакт родителя или ученика.");
      return;
    }
    openMessengerBy(type, contact, text);
  }

  function openMessengerBy(type, contact, text){
    const c = (contact || "").trim();
    if(!c){
      alert("Контакт не указан.");
      return;
    }
    const msg = encodeURIComponent(text);
    if(type==="whatsapp"){
      const phone=c.replace(/^\+/,"");
      window.open(`https://wa.me/${phone}?text=${msg}`,"_blank");
    } else if(type==="telegram"){
      const uname=c.startsWith("@")?c.substring(1):c;
      window.open(`https://t.me/${uname}?text=${msg}`,"_blank");
    } else {
      alert("Тип контакта — просто телефон. Можно вручную отправить сообщение:\n\n"+text);
    }
  }

