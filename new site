  function computeCriticalSubscriptions() {
    const result=[];
    data.students.forEach(st=>{
      const stats = getSubscriptionStats(st.id);
      const {sub,remaining,debt} = stats;
      if(!sub) return;
      if(remaining<=2 || debt>0){
        result.push({student:st, stats});
      }
    });
    result.sort((a,b)=>{
      const debtA = a.stats.debt || 0;
      const debtB = b.stats.debt || 0;
      if (debtA !== debtB) return debtB - debtA;
      return (a.stats.remaining || 0) - (b.stats.remaining || 0);
    });
    return result;
  }

  function getRecentTopics(limit=8) {
    const lessons = data.lessons
      .filter(l=>l.topic && l.topic.trim())
      .sort((a,b)=> (b.date||"").localeCompare(a.date||""));
    const seen = new Set();
    const result=[];
    for(const l of lessons){
      const t = l.topic.trim();
      if(!seen.has(t)){
        seen.add(t);
        result.push(t);
        if(result.length>=limit) break;
      }
    }
    return result;
  }

