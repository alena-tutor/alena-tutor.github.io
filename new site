      tasks.push({
        id:idRem,
        text:`Напомнить о занятии: ${labelBase}`,
        action:()=>sendLessonReminder(l,st)
      });

      if(l.hw && l.hw.trim()){
        const idHW=`homework|${l.id}`;
        tasks.push({
          id:idHW,
          text:`Отправить домашнее задание: ${name}`,
          action:()=>sendHomework(l,st)
        });
      }

      if(l.gradeLesson==null || l.gradeHW==null){
        const idGr=`grade|${l.id}`;
        tasks.push({
          id:idGr,
          text:`Поставить оценку: ${name}`,
          action:()=>openLessonView(l.id)
        });
      }
    });

    computeCriticalSubscriptions().forEach(({student,stats})=>{
      const idSub=`subNotify|${student.id}`;
      const base = stats.remaining<=0
        ? "Оповестить об окончании абонемента"
        : "Оповестить о скором окончании абонемента";
      tasks.push({
        id:idSub,
        text:`${base}: ${student.name}`,
        action:()=>notifySubscription(student,stats)
      });
    });

    return tasks;
  }

